{
  "aiUseDisclosure": "Claude scaffolded the original package; Codex migrated the active build, preview and browser verification commands to native Godot.",
  "name": "the-ninth-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An immortal cat king faces one returning soul across centuries of rule and ruin.",
  "scripts": {
    "dev": "node scripts/build-godot.mjs && node scripts/serve-godot.mjs",
    "build": "node scripts/build-godot.mjs",
    "preview": "node scripts/serve-godot.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/sim.ts --",
    "assets:key": "node scripts/chroma-key.mjs",
    "assets:crop": "node scripts/crop-lineup.mjs && node scripts/resize-sprites.mjs",
    "assets:pixel": "node scripts/export-pixel-sprites.mjs",
    "test:browser": "node scripts/build-godot.mjs && node scripts/godot-smoke.mjs",
    "legacy:dev": "vite",
    "legacy:build": "vite build",
    "legacy:preview": "vite preview",
    "legacy:test:browser": "npm run legacy:build && node scripts/gothic-v5-smoke.mjs && node scripts/royal-routes.mjs",
    "build:godot": "node scripts/build-godot.mjs",
    "godot:install": "node scripts/install-godot.mjs"
  },
  "dependencies": {
    "phaser": "3.88.2"
  },
  "devDependencies": {
    "playwright": "1.65.1",
    "sharp": "^0.33.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
